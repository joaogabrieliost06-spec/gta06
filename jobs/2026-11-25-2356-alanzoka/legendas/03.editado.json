{"blocos": [{"f": 1, "texto": "O helicóptero tá forte", "pos": 0.6}, {"f": 1, "texto": "em cima de nós, mano,", "pos": 0.6}, {"f": 1, "texto": "acho que helicóptero perdeu nós,", "pos": 0.6}, {"f": 1, "texto": "ele não tá entendendo nada", "pos": 0.6}, {"f": 1, "texto": "Mano,", "pos": 0.6}, {"f": 1, "texto": "esse helicóptero tá ramelando", "pos": 0.6}, {"f": 1, "texto": "atirou o pneu da minha moto,", "pos": 0.6}, {"f": 1, "texto": "que loucura,", "pos": 0.6}, {"f": 1, "texto": "eu acho. Mano,", "pos": 0.6}, {"f": 1, "texto": "ele realmente atirou", "pos": 0.6}, {"f": 1, "texto": "o pneu da minha moto, mano", "pos": 0.6}, {"f": 1, "texto": "Porcento, porcento, não,", "pos": 0.6}, {"f": 1, "texto": "acelera", "pos": 0.6}]}