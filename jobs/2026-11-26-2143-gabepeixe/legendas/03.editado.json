{"blocos": [{"f": 1, "texto": "Conhece? O Coringa", "pos": 0.46}, {"f": 1, "texto": "mandou no grupo assim:", "pos": 0.46}, {"f": 1, "texto": "\"Pra não dar problema", "pos": 0.46}, {"f": 1, "texto": "na portaria por causa", "pos": 0.46}, {"f": 1, "texto": "do casamento, cadastra", "pos": 0.46}, {"f": 1, "texto": "aqui os seus dados que", "pos": 0.46}, {"f": 1, "texto": "você vai vir pro casamento", "pos": 0.46}, {"f": 1, "texto": "e tal, pra não ter", "pos": 0.46}, {"f": 1, "texto": "problema na portaria\"", "pos": 0.46}, {"f": 1, "texto": "O Brabox me manda:", "pos": 0.46}, {"f": 1, "texto": "\"Eu preciso cadastrar?\"", "pos": 0.46}, {"f": 1, "texto": "Eu moro aqui, mano", "pos": 0.46}, {"f": 1, "texto": "O Brabox às vezes", "pos": 0.46}, {"f": 1, "texto": "me surpreende, viado", "pos": 0.46}, {"f": 1, "texto": "Porque às vezes eu acho", "pos": 0.46}, {"f": 1, "texto": "que ele tem o QI", "pos": 0.46}, {"f": 1, "texto": "de ameba, viado", "pos": 0.46}, {"f": 1, "texto": "Por que que se ele", "pos": 0.46}, {"f": 1, "texto": "mora aqui e tá dentro", "pos": 0.46}, {"f": 1, "texto": "pra que que ele vai cadastrar", "pos": 0.46}, {"f": 1, "texto": "na portaria, viado?", "pos": 0.46}, {"f": 1, "texto": "É imoral, viado. É imoral", "pos": 0.46}, {"f": 1, "texto": "Eu olhei um negócio desse,", "pos": 0.46}, {"f": 1, "texto": "é imoral, viado", "pos": 0.46}, {"f": 1, "texto": "Pra quê? Pra quê?", "pos": 0.46}, {"f": 1, "texto": "Não faz sentido", "pos": 0.46}, {"f": 1, "texto": "Tá, beleza", "pos": 0.46}, {"f": 1, "texto": "O cara falou que era", "pos": 0.46}, {"f": 1, "texto": "pra eu chegar aqui e", "pos": 0.46}, {"f": 1, "texto": "vou contextualizar", "pos": 0.46}]}