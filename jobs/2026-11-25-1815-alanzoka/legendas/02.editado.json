{"blocos": [{"f": 1, "texto": "Calçado, o que eu quero?", "pos": 0.76}, {"f": 1, "texto": "Eu quero um tênis, mano", "pos": 0.76}, {"f": 1, "texto": "Caralho, chat", "pos": 0.76}, {"f": 1, "texto": "Ficou show, hein, mano?", "pos": 0.76}, {"f": 1, "texto": "Ficou show, hein?", "pos": 0.76}, {"f": 1, "texto": "Não?", "pos": 0.46}, {"f": 1, "texto": "Caralho, ficou insano, mano", "pos": 0.46}, {"f": 1, "texto": "Ó, esse daqui orna, mano", "pos": 0.46}, {"f": 1, "texto": "Esse daqui orna, hein?", "pos": 0.46}, {"f": 1, "texto": "Caralho, esse daqui ficou da hora", "pos": 0.46}, {"f": 1, "texto": "Esse daqui ficou absurdo", "pos": 0.46}, {"f": 1, "texto": "Esse ficou insano", "pos": 0.46}, {"f": 1, "texto": "Esse ficou insano, mano", "pos": 0.46}, {"f": 1, "texto": "Insano esse ficou", "pos": 0.46}, {"f": 1, "texto": "Cara, gostei desse daqui", "pos": 0.46}, {"f": 1, "texto": "também, mano", "pos": 0.46}, {"f": 1, "texto": "Gostei desse daqui também, viu?", "pos": 0.46}, {"f": 1, "texto": "Ah, vou botar esse daqui, mano", "pos": 0.46}, {"f": 1, "texto": "Esse daqui ficou legal", "pos": 0.46}, {"f": 1, "texto": "Gostei. Já pode salvar esse daqui, mano", "pos": 0.46}, {"f": 1, "texto": "Como é que salva?", "pos": 0.46}, {"f": 1, "texto": "Como é que salva, mano?", "pos": 0.46}, {"f": 1, "texto": "Já salva esse daqui", "pos": 0.46}, {"f": 1, "texto": "Qual que eu enjoei, mano?", "pos": 0.46}, {"f": 1, "texto": "Eu enjoei do Arthur Morgan", "pos": 0.46}, {"f": 1, "texto": "Tiro o Arthur Morgan do carro", "pos": 0.46}, {"f": 1, "texto": "Enjoei desse daqui também", "pos": 0.46}]}