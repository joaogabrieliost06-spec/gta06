{"blocos": [{"f": 1, "texto": "Ai, meu Deus, meu jogo", "pos": 0.46}, {"f": 1, "texto": "não recebe missão", "pos": 0.46}, {"f": 1, "texto": "Mano, como é que eu faço", "pos": 0.46}, {"f": 1, "texto": "ela perder músculo, cara?", "pos": 0.46}, {"f": 1, "texto": "Ela tá muito musculosa,", "pos": 0.46}, {"f": 1, "texto": "velho, eu preciso perder", "pos": 0.46}, {"f": 1, "texto": "esses músculos, mano,", "pos": 0.46}, {"f": 1, "texto": "como é que perde músculo?", "pos": 0.46}, {"f": 1, "texto": "Já não tô treinando,", "pos": 0.46}, {"f": 1, "texto": "tá ligado?", "pos": 0.46}, {"f": 1, "texto": "Olha esses trícepses,", "pos": 0.46}, {"f": 1, "texto": "ela tinha que subir", "pos": 0.46}, {"f": 1, "texto": "pelo elevador,", "pos": 0.46}, {"f": 1, "texto": "por esse elevador, mano.", "pos": 0.46}, {"f": 1, "texto": "Caralho, mano, o dev", "pos": 0.46}, {"f": 1, "texto": "do serviço de quarto, mano,", "pos": 0.46}, {"f": 1, "texto": "fez um trabalho aqui.", "pos": 0.46}, {"f": 1, "texto": "Será o Jason, posso saber? Tome", "pos": 0.46}, {"f": 1, "texto": "bastante chocolate,", "pos": 0.46}, {"f": 1, "texto": "bebê, que a gente tem", "pos": 0.46}, {"f": 1, "texto": "que perder músculo.", "pos": 0.46}]}