{"blocos": [{"f": 1, "texto": "taquei uma granada sem querer,", "pos": 0.6}, {"f": 1, "texto": "peru,", "pos": 0.6}, {"f": 1, "texto": "mano, eu não sei como eu taquei", "pos": 0.6}, {"f": 1, "texto": "uma granada, tá, de verdade,", "pos": 0.6}, {"f": 1, "texto": "não sei qual que é o botão que eu apertei", "pos": 0.6}, {"f": 1, "texto": "pra tacar uma granada, eu não sei,", "pos": 0.6}, {"f": 1, "texto": "literalmente tacou sozinha a granada,", "pos": 0.6}, {"f": 1, "texto": "eu nem selecionei a granada,", "pos": 0.6}, {"f": 1, "texto": "vocês viram, né,", "pos": 0.6}, {"f": 1, "texto": "o peru atrás,", "pos": 0.6}, {"f": 1, "texto": "como que eu taquei a granada,", "pos": 0.6}, {"f": 1, "texto": "eu segurei, tava mirando,", "pos": 0.6}, {"f": 1, "texto": "só apertei,", "pos": 0.6}, {"f": 1, "texto": "eu não sei, mano,", "pos": 0.6}, {"f": 1, "texto": "como é que ele tacou a granada,", "pos": 0.6}, {"f": 1, "texto": "velho, de verdade,", "pos": 0.6}, {"f": 1, "texto": "tá, peru branco, já pegamos,", "pos": 0.6}, {"f": 1, "texto": "falta agora o cangambá pintado,", "pos": 0.6}, {"f": 1, "texto": "o que é um cangambá pintado, mano,", "pos": 0.6}, {"f": 1, "texto": "o que que é isso aqui,", "pos": 0.6}, {"f": 1, "texto": "é um cangambá? Ai", "pos": 0.6}, {"f": 1, "texto": "meu Deus, é o peru que explodiu, mano", "pos": 0.6}]}