{"blocos": [{"f": 1, "texto": "Ameaça chover, cara,", "pos": 0.6}, {"f": 1, "texto": "tá com mó cara de chuva, não tá?", "pos": 0.6}, {"f": 1, "texto": "Caralho, querida, sai da rua, ô.", "pos": 0.6}, {"f": 1, "texto": "É, atropelada,", "pos": 0.6}, {"f": 1, "texto": "a culpa é minha, né?", "pos": 0.6}, {"f": 1, "texto": "Ciclofaixa não é enfeite não,", "pos": 0.6}, {"f": 1, "texto": "ô seu merda.", "pos": 0.6}, {"f": 1, "texto": "Vamos trocar de roupa, chat.", "pos": 0.6}, {"f": 1, "texto": "Amanhã a gente vai", "pos": 0.6}, {"f": 1, "texto": "montar uns looks novos.", "pos": 0.6}, {"f": 1, "texto": "Vários fotógrafos.", "pos": 0.6}]}