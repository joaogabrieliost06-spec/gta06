{"blocos": [{"f": 1, "texto": "pô, não tinha um contorno", "pos": 0.6}, {"f": 1, "texto": "pra fazer o barco andar sozinho?", "pos": 0.6}, {"f": 1, "texto": "Não lembro qual que era,", "pos": 0.6}, {"f": 1, "texto": "não era esse,", "pos": 0.6}, {"f": 1, "texto": "acho que tinha outro, pô,", "pos": 0.6}, {"f": 1, "texto": "mas vamos andar sozinho um pouco, né,", "pos": 0.6}, {"f": 1, "texto": "deixa o barco andar sozinho aí,", "pos": 0.6}, {"f": 1, "texto": "bota uma música,", "pos": 0.6}, {"f": 1, "texto": "tá ligado já a música,", "pos": 0.6}, {"f": 1, "texto": "mano, eu botei pro barco andar sozinho, pô,", "pos": 0.6}, {"f": 1, "texto": "o barco vai atolar?", "pos": 0.6}, {"f": 1, "texto": "Isso,", "pos": 0.6}, {"f": 1, "texto": "o barco literalmente atolou, mano,", "pos": 0.6}, {"f": 1, "texto": "ele parou por quê? Fala pra mim,", "pos": 0.6}, {"f": 1, "texto": "mas na moral não é possível, mano,", "pos": 0.6}, {"f": 1, "texto": "cara, não é possível isso, velho,", "pos": 0.6}, {"f": 1, "texto": "o barco atolou andando sozinho,", "pos": 0.6}, {"f": 1, "texto": "Deus, tá", "pos": 0.6}, {"f": 1, "texto": "ficando no chão?", "pos": 0.6}, {"f": 1, "texto": "Cara, acho esse barco é muito grande, cara,", "pos": 0.6}, {"f": 1, "texto": "tinha que ter pegado um barco menor, velho,", "pos": 0.6}, {"f": 1, "texto": "mano, ele não tem altura mínima", "pos": 0.6}, {"f": 1, "texto": "pra passar aqui.", "pos": 0.6}]}