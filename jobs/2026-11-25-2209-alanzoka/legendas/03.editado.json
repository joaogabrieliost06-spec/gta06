{"blocos": [{"f": 1, "texto": "na vida real, mano.", "pos": 0.6}, {"f": 1, "texto": "Nossa senhora,", "pos": 0.6}, {"f": 1, "texto": "não passou nem um quilômetro,", "pos": 0.6}, {"f": 1, "texto": "Por que que eu ganhei...", "pos": 0.6}, {"f": 1, "texto": "O que eu fiz?", "pos": 0.6}, {"f": 1, "texto": "Um baú no fundo do...", "pos": 0.6}, {"f": 1, "texto": "Por que que eu ganhei...", "pos": 0.6}, {"f": 1, "texto": "Caveirinha?", "pos": 0.6}, {"f": 1, "texto": "Eu atropelei um peixe, mano, será?", "pos": 0.6}, {"f": 1, "texto": "Mas caralho, mano!", "pos": 0.6}, {"f": 1, "texto": "Pra um peixe morrer atropelado,", "pos": 0.6}, {"f": 1, "texto": "ele tem que ser tipo, muito burro, né, mano?", "pos": 0.6}, {"f": 1, "texto": "É tipo uma pessoa ser atropelada", "pos": 0.6}, {"f": 1, "texto": "por um avião no ar, mano.", "pos": 0.6}, {"f": 1, "texto": "É impossível, porque teoricamente", "pos": 0.6}, {"f": 1, "texto": "eu tô voando no mar.", "pos": 0.6}, {"f": 1, "texto": "Então, pro peixe ser atropelado,", "pos": 0.6}, {"f": 1, "texto": "ele tem que estar em cima, mano.", "pos": 0.6}, {"f": 1, "texto": "Não embaixo, cara.", "pos": 0.6}, {"f": 1, "texto": "Não faz nem sentido, né?", "pos": 0.6}, {"f": 1, "texto": "Não?", "pos": 0.6}, {"f": 1, "texto": "Ué, cara, eu tô em cima do mar", "pos": 0.6}, {"f": 1, "texto": "Eu tô tipo no céu,", "pos": 0.6}, {"f": 1, "texto": "se eu fosse na terra Entendeu?", "pos": 0.6}, {"f": 1, "texto": "Ué, não", "pos": 0.6}, {"f": 1, "texto": "Ué, pensa comigo", "pos": 0.6}, {"f": 1, "texto": "Eu tô tipo, eu sou tipo", "pos": 0.6}, {"f": 1, "texto": "um avião do mar, mano", "pos": 0.6}, {"f": 1, "texto": "Eu tô no céu deles,", "pos": 0.6}, {"f": 1, "texto": "o céu deles é a superfície, mano", "pos": 0.6}, {"f": 1, "texto": "cara conseguiu se atropelar", "pos": 0.6}]}