{"blocos": [{"f": 1, "texto": "Ah, eu não gostaria", "pos": 0.6}, {"f": 1, "texto": "que batessem", "pos": 0.6}, {"f": 1, "texto": "minha mala, então eu", "pos": 0.6}, {"f": 1, "texto": "vou fazer bem", "pos": 0.6}, {"f": 3, "texto": "tranquilo", "pos": 0.6}, {"f": 2, "texto": "Ah, não. É o cara", "pos": 0.6}, {"f": 2, "texto": "que não pegou, né?", "pos": 0.6}, {"f": 2, "texto": "Não entendi.", "pos": 0.6}, {"f": 1, "texto": "Na moral, cara,", "pos": 0.6}, {"f": 1, "texto": "é difícil, mano.", "pos": 0.6}, {"f": 1, "texto": "É difícil soltar", "pos": 0.6}, {"f": 1, "texto": "na barrinha, mano.", "pos": 0.6}, {"f": 1, "texto": "Ele que não tá", "pos": 0.6}, {"f": 1, "texto": "pegando a maldade,", "pos": 0.6}, {"f": 1, "texto": "velho.", "pos": 0.6}, {"f": 1, "texto": "Agora vai.", "pos": 0.6}, {"f": 1, "texto": "Vou soltar antes,", "pos": 0.6}, {"f": 1, "texto": "mano.", "pos": 0.6}, {"f": 1, "texto": "Nice.", "pos": 0.6}]}