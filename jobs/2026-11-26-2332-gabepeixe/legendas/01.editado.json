{"blocos": [{"f": 1, "texto": "Conseguimos, não letal,", "pos": 0.46}, {"f": 1, "texto": "aí, ó", "pos": 0.46}, {"f": 1, "texto": "Nossa senhora,", "pos": 0.46}, {"f": 1, "texto": "quem fez isso aí?", "pos": 0.46}, {"f": 1, "texto": "O cara que terminou", "pos": 0.46}, {"f": 1, "texto": "meio período no Senai?", "pos": 0.46}, {"f": 1, "texto": "Cabo azul, não", "pos": 0.46}, {"f": 1, "texto": "grosso fino.", "pos": 0.46}, {"f": 1, "texto": "Ah, é de rede?", "pos": 0.46}, {"f": 1, "texto": "Se for de rede,", "pos": 0.46}, {"f": 1, "texto": "eu sei qual que é.", "pos": 0.46}, {"f": 1, "texto": "Ah, mas aí não vai ver.", "pos": 0.46}, {"f": 1, "texto": "O que eu entendo", "pos": 0.46}, {"f": 1, "texto": "não aparece, né?", "pos": 0.46}, {"f": 1, "texto": "Beleza.", "pos": 0.46}]}