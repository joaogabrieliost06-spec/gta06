{"blocos": [{"f": 1, "texto": "Arme a carga", "de": 2.06, "ate": 2.96, "pos": 0.46}, {"f": 1, "texto": "em uma das torres", "de": 2.96, "ate": 4.02, "pos": 0.46}, {"f": 1, "texto": "de celular.", "de": 4.02, "ate": 5.06, "pos": 0.46}, {"f": 1, "texto": "Tá, como é que eu vou subir", "de": 7.04, "ate": 7.98, "pos": 0.46}, {"f": 1, "texto": "na torre de celular?", "de": 7.98, "ate": 8.98, "pos": 0.46}, {"f": 1, "texto": "Mano, esse daqui é o beco", "de": 9.83, "ate": 10.83, "pos": 0.46}, {"f": 1, "texto": "que a gente mata", "de": 10.83, "ate": 11.49, "pos": 0.46}, {"f": 1, "texto": "o... que a gente tem", "de": 11.49, "ate": 12.33, "pos": 0.46}, {"f": 1, "texto": "um encontro", "de": 12.33, "ate": 13.6, "pos": 0.46}, {"f": 1, "texto": "de drogas no Vice", "de": 13.6, "ate": 15.06, "pos": 0.46}, {"f": 1, "texto": "City, mano.", "de": 15.06, "ate": 15.6, "pos": 0.46}, {"f": 1, "texto": "Que a gente tem", "de": 16.01, "ate": 17.03, "pos": 0.46}, {"f": 1, "texto": "que ficar em cima dos caras como", "de": 17.03, "ate": 18.01, "pos": 0.46}, {"f": 1, "texto": "sniper, tá ligado?", "de": 18.01, "ate": 18.85, "pos": 0.46}, {"f": 1, "texto": "Esperando os caras", "de": 18.91, "ate": 19.67, "pos": 0.46}, {"f": 1, "texto": "conversarem.", "de": 21.48, "ate": 22.62, "pos": 0.46}, {"f": 1, "texto": "literalmente esse", "de": 22.78, "ate": 23.36, "pos": 0.46}, {"f": 1, "texto": "beco, mano.", "de": 23.36, "ate": 23.82, "pos": 0.46}, {"f": 2, "texto": "Eu confirmo, mano.", "de": 25.67, "ate": 26.53, "pos": 0.46}, {"f": 2, "texto": "Os devs confirmaram,", "de": 29.49, "ate": 30.55, "pos": 0.46}, {"f": 2, "texto": "mano.", "de": 30.67, "ate": 30.83, "pos": 0.46}, {"f": 2, "texto": "Me perdi, mano", "de": 54.51, "ate": 55.21, "pos": 0.46}, {"f": 2, "texto": "Porra, essa porra não", "de": 61.41, "ate": 61.99, "pos": 0.46}, {"f": 2, "texto": "explode não, né", "de": 61.99, "ate": 62.63, "pos": 0.46}, {"f": 2, "texto": "Porra, meu Deus, o cara vai ficar", "de": 65.87, "ate": 66.67, "pos": 0.46}, {"f": 2, "texto": "fazendo", "de": 66.67, "ate": 67.07, "pos": 0.46}, {"f": 2, "texto": "Bagulho psicológico comigo", "de": 67.97, "ate": 68.83, "pos": 0.46}, {"f": 2, "texto": "Eu tenho que pegar", "de": 69.83, "ate": 70.41, "pos": 0.46}, {"f": 2, "texto": "um elevador, mano", "de": 70.41, "ate": 71.17, "pos": 0.46}, {"f": 2, "texto": "Como é que eu subo nessa", "de": 71.17, "ate": 71.93, "pos": 0.46}, {"f": 1, "texto": "porra dessa torre?", "de": 71.93, "ate": 72.85, "pos": 0.46}, {"f": 1, "texto": "Qual", "de": 72.85, "ate": 73.37, "pos": 0.46}, {"f": 1, "texto": "que é o segredo?", "de": 75.47, "ate": 76.25, "pos": 0.46}]}