{"blocos": [{"f": 1, "texto": "Pelo amor de Deus,", "pos": 0.46}, {"f": 1, "texto": "já botei pra tirar", "pos": 0.46}, {"f": 1, "texto": "e botar a máscara", "pos": 0.46}, {"f": 1, "texto": "de novo,", "pos": 0.46}, {"f": 1, "texto": "ó,", "pos": 0.46}, {"f": 1, "texto": "não, não tem máscara", "pos": 0.46}, {"f": 1, "texto": "Se", "pos": 0.46}, {"f": 1, "texto": "essa filha da puta", "pos": 0.46}, {"f": 1, "texto": "tiver de máscara,", "pos": 0.46}, {"f": 1, "texto": "a gente foi pego", "pos": 0.46}, {"f": 1, "texto": "de novo, porque ela", "pos": 0.46}, {"f": 1, "texto": "não tirou E eu", "pos": 0.46}, {"f": 1, "texto": "já mandei tirar", "pos": 0.46}, {"f": 1, "texto": "cinco vezes,", "pos": 0.46}, {"f": 1, "texto": "eu faço isso direto", "pos": 0.46}, {"f": 1, "texto": "de tirar a máscara,", "pos": 0.46}, {"f": 1, "texto": "colocar a máscara", "pos": 0.46}, {"f": 1, "texto": "Quando um tira,", "pos": 0.46}, {"f": 1, "texto": "os dois tiram,", "pos": 0.46}, {"f": 1, "texto": "vou ficar maluco,", "pos": 0.46}, {"f": 1, "texto": "viado", "pos": 0.46}]}