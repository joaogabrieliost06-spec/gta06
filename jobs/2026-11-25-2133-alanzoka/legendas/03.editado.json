{"blocos": [{"f": 1, "texto": "Caraca, que vontade de me jogar aqui,", "pos": 0.6}, {"f": 1, "texto": "pular nessa piscina, chat,", "pos": 0.6}, {"f": 1, "texto": "vocês acham que é possível, mano?", "pos": 0.6}, {"f": 1, "texto": "Cara, eu tô afim de fazer", "pos": 0.6}, {"f": 1, "texto": "uma loucura, mano,", "pos": 0.6}, {"f": 1, "texto": "pensamento intrusivo,", "pos": 0.6}, {"f": 1, "texto": "eu tô com pensamento intrusivo, mano,", "pos": 0.6}, {"f": 1, "texto": "agora salvou meu jogo?", "pos": 0.6}, {"f": 1, "texto": "Ah, mano, salvou agora há pouco,", "pos": 0.6}, {"f": 1, "texto": "eu vou!", "pos": 0.6}, {"f": 1, "texto": "Relaxa, gente,", "pos": 0.6}, {"f": 1, "texto": "mano, porra, quebrou minha imersão, mano,", "pos": 0.6}, {"f": 1, "texto": "esse paraquedas, na moral, velho", "pos": 0.6}]}