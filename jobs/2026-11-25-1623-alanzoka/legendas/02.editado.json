{"blocos": [{"f": 1, "texto": "Meu Deus, matei", "de": 0.01, "ate": 0.59, "pos": 0.46}, {"f": 1, "texto": "amigo, eu acho,", "de": 0.59, "ate": 1.19, "pos": 0.46}, {"f": 1, "texto": "eu não sei quem,", "de": 6.73, "ate": 7.25, "pos": 0.46}, {"f": 1, "texto": "mano, eu não sei", "de": 9.91, "ate": 10.61, "pos": 0.76}, {"f": 1, "texto": "quem é do bem e quem é", "de": 10.61, "ate": 11.19, "pos": 0.76}, {"f": 1, "texto": "do mal aqui, velho,", "de": 11.19, "ate": 12.35, "pos": 0.46}, {"f": 1, "texto": "só sai atirando", "de": 16.19, "ate": 16.95, "pos": 0.46}, {"f": 1, "texto": "em todo mundo, mano", "de": 16.95, "ate": 17.57, "pos": 0.46}, {"f": 2, "texto": "Cara, esses caras são do mal,", "de": 31.11, "ate": 32.51, "pos": 0.46}, {"f": 2, "texto": "mano.", "de": 32.59, "ate": 32.77, "pos": 0.76}, {"f": 1, "texto": "Não, desculpa.", "de": 81.59, "ate": 82.15, "pos": 0.46}, {"f": 1, "texto": "Desculpa, irmão.", "de": 83.83, "ate": 84.31, "pos": 0.46}, {"f": 1, "texto": "Chutei sem querer,", "de": 84.39, "ate": 85.07, "pos": 0.46}, {"f": 1, "texto": "mano. Eu não sei nem porque eu", "de": 85.25, "ate": 86.23, "pos": 0.46}, {"f": 1, "texto": "apertei o botão", "de": 86.23, "ate": 86.79, "pos": 0.46}, {"f": 1, "texto": "de chute.", "de": 86.79, "ate": 87.17, "pos": 0.46}]}