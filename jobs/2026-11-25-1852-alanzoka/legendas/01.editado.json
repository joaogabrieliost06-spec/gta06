{"blocos": [{"f": 1, "texto": "Ela caiu sozinha, cara", "pos": 0.6}, {"f": 1, "texto": "Tô falando que esse jogo", "pos": 0.6}, {"f": 1, "texto": "é bugado, mano", "pos": 0.6}, {"f": 1, "texto": "Tô falando, ela caiu sozinha, mano", "pos": 0.6}, {"f": 1, "texto": "Mano, na moral, velho", "pos": 0.6}, {"f": 1, "texto": "Pra dar grau de patinete, mano?", "pos": 0.6}, {"f": 1, "texto": "Caralho, bebê", "pos": 0.6}, {"f": 1, "texto": "tá vindo rápido, hein?", "pos": 0.6}, {"f": 1, "texto": "Ah, tá acabando a Beira-Mar, mano", "pos": 0.6}, {"f": 1, "texto": "Ah, merda", "pos": 0.6}, {"f": 1, "texto": "Mano, fala sério, velho, cara", "pos": 0.6}, {"f": 1, "texto": "Ele caiu como?", "pos": 0.6}, {"f": 1, "texto": "Eu tô com sono, gente", "pos": 0.6}, {"f": 1, "texto": "eu não dormi direito", "pos": 0.6}, {"f": 1, "texto": "Dá um descontinho", "pos": 0.6}, {"f": 1, "texto": "Hoje eu tô zoado, mano", "pos": 0.6}, {"f": 1, "texto": "ontem eu não tava", "pos": 0.6}, {"f": 1, "texto": "ontem também não", "pos": 0.6}, {"f": 1, "texto": "Mas hoje eu tô, velho", "pos": 0.6}]}