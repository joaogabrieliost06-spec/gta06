{"segments": [{"start": 4, "end": 6.2, "text": "É louco, que é isso, mano,", "words": [{"word": "É", "start": 4.0, "end": 4.37}, {"word": "louco,", "start": 4.37, "end": 4.73}, {"word": "que", "start": 4.73, "end": 5.1}, {"word": "é", "start": 5.1, "end": 5.47}, {"word": "isso,", "start": 5.47, "end": 5.83}, {"word": "mano,", "start": 5.83, "end": 6.2}], "pos": 0.6}, {"start": 6.2, "end": 8.5, "text": "tem muita gente nessa piscina", "words": [{"word": "tem", "start": 6.2, "end": 6.66}, {"word": "muita", "start": 6.66, "end": 7.12}, {"word": "gente", "start": 7.12, "end": 7.58}, {"word": "nessa", "start": 7.58, "end": 8.04}, {"word": "piscina", "start": 8.04, "end": 8.5}], "pos": 0.6}, {"start": 19, "end": 21, "text": "Tá me olhando, tia", "words": [{"word": "Tá", "start": 19.0, "end": 19.5}, {"word": "me", "start": 19.5, "end": 20.0}, {"word": "olhando,", "start": 20.0, "end": 20.5}, {"word": "tia", "start": 20.5, "end": 21.0}], "pos": 0.6}, {"start": 28, "end": 31, "text": "Meu Deus, eu não paguei nem meu filho!", "words": [{"word": "Meu", "start": 28.0, "end": 28.38}, {"word": "Deus,", "start": 28.38, "end": 28.75}, {"word": "eu", "start": 28.75, "end": 29.12}, {"word": "não", "start": 29.12, "end": 29.5}, {"word": "paguei", "start": 29.5, "end": 29.88}, {"word": "nem", "start": 29.88, "end": 30.25}, {"word": "meu", "start": 30.25, "end": 30.62}, {"word": "filho!", "start": 30.62, "end": 31.0}], "pos": 0.6}, {"start": 38, "end": 40, "text": "Mano, eu preciso de muito dinheiro", "words": [{"word": "Mano,", "start": 38.0, "end": 38.33}, {"word": "eu", "start": 38.33, "end": 38.67}, {"word": "preciso", "start": 38.67, "end": 39.0}, {"word": "de", "start": 39.0, "end": 39.33}, {"word": "muito", "start": 39.33, "end": 39.67}, {"word": "dinheiro", "start": 39.67, "end": 40.0}], "pos": 0.6}, {"start": 40, "end": 41.5, "text": "pro meu filho ainda, cara", "words": [{"word": "pro", "start": 40.0, "end": 40.3}, {"word": "meu", "start": 40.3, "end": 40.6}, {"word": "filho", "start": 40.6, "end": 40.9}, {"word": "ainda,", "start": 40.9, "end": 41.2}, {"word": "cara", "start": 41.2, "end": 41.5}], "pos": 0.6}, {"start": 50, "end": 52, "text": "Nossa, chat!", "words": [{"word": "Nossa,", "start": 50.0, "end": 51.0}, {"word": "chat!", "start": 51.0, "end": 52.0}], "pos": 0.6}, {"start": 53, "end": 56, "text": "Tá bom, deixa eu ver", "words": [{"word": "Tá", "start": 53.0, "end": 53.6}, {"word": "bom,", "start": 53.6, "end": 54.2}, {"word": "deixa", "start": 54.2, "end": 54.8}, {"word": "eu", "start": 54.8, "end": 55.4}, {"word": "ver", "start": 55.4, "end": 56.0}], "pos": 0.6}, {"start": 62, "end": 64, "text": "Mano, gastei todo meu dinheiro", "words": [{"word": "Mano,", "start": 62.0, "end": 62.4}, {"word": "gastei", "start": 62.4, "end": 62.8}, {"word": "todo", "start": 62.8, "end": 63.2}, {"word": "meu", "start": 63.2, "end": 63.6}, {"word": "dinheiro", "start": 63.6, "end": 64.0}], "pos": 0.6}, {"start": 64, "end": 66, "text": "Vamos ver quanto por cento nós tá?", "words": [{"word": "Vamos", "start": 64.0, "end": 64.29}, {"word": "ver", "start": 64.29, "end": 64.57}, {"word": "quanto", "start": 64.57, "end": 64.86}, {"word": "por", "start": 64.86, "end": 65.14}, {"word": "cento", "start": 65.14, "end": 65.43}, {"word": "nós", "start": 65.43, "end": 65.71}, {"word": "tá?", "start": 65.71, "end": 66.0}], "pos": 0.6}, {"start": 73, "end": 74.8, "text": "Caralho, eu fiquei 3 horas na missão,", "words": [{"word": "Caralho,", "start": 73.0, "end": 73.26}, {"word": "eu", "start": 73.26, "end": 73.51}, {"word": "fiquei", "start": 73.51, "end": 73.77}, {"word": "3", "start": 73.77, "end": 74.03}, {"word": "horas", "start": 74.03, "end": 74.29}, {"word": "na", "start": 74.29, "end": 74.54}, {"word": "missão,", "start": 74.54, "end": 74.8}], "pos": 0.6}, {"start": 74.8, "end": 76.5, "text": "73 ainda, mano", "words": [{"word": "73", "start": 74.8, "end": 75.37}, {"word": "ainda,", "start": 75.37, "end": 75.93}, {"word": "mano", "start": 75.93, "end": 76.5}], "pos": 0.6}]}