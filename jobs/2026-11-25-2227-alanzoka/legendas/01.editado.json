{"blocos": [{"f": 1, "texto": "Desculpa, gente,", "pos": 0.6}, {"f": 1, "texto": "o barco tá parado porque", "pos": 0.6}, {"f": 1, "texto": "a gente chegou no lugar, mano", "pos": 0.6}, {"f": 1, "texto": "Bebezinha quer dar um beijinho", "pos": 0.6}, {"f": 1, "texto": "bem marítimo", "pos": 0.6}, {"f": 1, "texto": "Ai, como você anda bonitinha", "pos": 0.6}, {"f": 1, "texto": "Que biquíni é esse?", "pos": 0.6}, {"f": 1, "texto": "Eu nunca vi", "pos": 0.6}, {"f": 1, "texto": "É novo?", "pos": 0.6}, {"f": 1, "texto": "Ela anda toda com o pé de pato, mano", "pos": 0.6}, {"f": 1, "texto": "Meu Deus,", "pos": 0.6}, {"f": 1, "texto": "o é isso?", "pos": 0.6}, {"f": 1, "texto": "É um tubarão Marcelo!", "pos": 0.6}, {"f": 1, "texto": "Tubarão Marcelo", "pos": 0.6}, {"f": 1, "texto": "acho que não morde, mano", "pos": 0.6}, {"f": 1, "texto": "quando eu fecho a boca", "pos": 0.6}]}