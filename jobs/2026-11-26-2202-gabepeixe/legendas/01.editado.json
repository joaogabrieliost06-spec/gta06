{"blocos": [{"f": 1, "texto": "Parecendo que estou tendo", "pos": 0.46}, {"f": 1, "texto": "uma convulsão, mano,", "pos": 0.46}, {"f": 1, "texto": "agora, vamos ver, né,", "pos": 0.46}, {"f": 1, "texto": "vamos ver se o buraco", "pos": 0.46}, {"f": 1, "texto": "está aberto aqui,", "pos": 0.46}, {"f": 1, "texto": "se o buraco estiver,", "pos": 0.46}, {"f": 1, "texto": "está de boa,", "pos": 0.46}, {"f": 1, "texto": "ele deixou aberto", "pos": 0.46}, {"f": 1, "texto": "o buraco de novo, viado,", "pos": 0.46}, {"f": 1, "texto": "pô, mas aí ficou", "pos": 0.46}, {"f": 1, "texto": "fácil demais, pô,", "pos": 0.46}, {"f": 1, "texto": "vou entrar pelo mesmo lugar", "pos": 0.46}, {"f": 1, "texto": "que eu entrei da primeira vez, mano,", "pos": 0.46}, {"f": 1, "texto": "liguei,", "pos": 0.46}, {"f": 1, "texto": "ih, não vou não,", "pos": 0.46}, {"f": 1, "texto": "ele fechou,", "pos": 0.46}, {"f": 1, "texto": "puta, ele fechou, mano,", "pos": 0.46}, {"f": 1, "texto": "tá, mas dá para", "pos": 0.46}, {"f": 1, "texto": "fazer um esquema, não,", "pos": 0.46}, {"f": 1, "texto": "consigo tacar", "pos": 0.46}, {"f": 1, "texto": "granada ali mesmo,", "pos": 0.46}, {"f": 1, "texto": "ué,", "pos": 0.46}, {"f": 1, "texto": "só subir na torre", "pos": 0.46}, {"f": 1, "texto": "e se jogar aqui dentro, não,", "pos": 0.46}, {"f": 1, "texto": "ué,", "pos": 0.46}, {"f": 1, "texto": "só subir na torre", "pos": 0.46}, {"f": 1, "texto": "e se jogar aqui dentro,", "pos": 0.46}, {"f": 1, "texto": "caralho, que cara", "pos": 0.46}, {"f": 1, "texto": "burro do caralho, viado,", "pos": 0.46}]}