{"blocos": [{"f": 1, "texto": "chapéu de Arthur", "de": 6.91, "ate": 7.49, "pos": 0.76}, {"f": 1, "texto": "Morgan.", "de": 7.49, "ate": 8.07, "pos": 0.76}, {"f": 1, "texto": "Cara, preciso trocar", "de": 18.27, "ate": 18.93, "pos": 0.76}, {"f": 1, "texto": "de roupa.", "de": 18.93, "ate": 19.51, "pos": 0.76}, {"f": 1, "texto": "Eles me chamaram carro.", "de": 20.42, "ate": 21.34, "pos": 0.76}, {"f": 1, "texto": "Qual carro que eu", "de": 23.58, "ate": 24.34, "pos": 0.76}, {"f": 1, "texto": "vou chamar?", "de": 24.34, "ate": 24.86, "pos": 0.76}, {"f": 1, "texto": "O meu tá sendo perseguido", "de": 24.96, "ate": 25.84, "pos": 0.76}, {"f": 1, "texto": "pela polícia, esse", "de": 25.84, "ate": 26.62, "pos": 0.76}, {"f": 1, "texto": "daqui?", "de": 26.62, "ate": 26.82, "pos": 0.76}, {"f": 1, "texto": "Calma, esse é", "de": 44.53, "ate": 45.07, "pos": 0.76}, {"f": 1, "texto": "o casual pro dia", "de": 45.07, "ate": 45.71, "pos": 0.76}, {"f": 1, "texto": "-a -dia ou eu esqueci de apertar", "de": 45.71, "ate": 46.77, "pos": 0.76}, {"f": 1, "texto": "o botão pra trocar? Ah, não, esse daqui", "de": 46.77, "ate": 52.34, "pos": 0.76}, {"f": 2, "texto": "eu enjoei já essa roupa.", "de": 52.34, "ate": 53.3, "pos": 0.6}, {"f": 2, "texto": "Me desculpa, eu preciso fazer", "de": 53.34, "ate": 54.1, "pos": 0.76}, {"f": 2, "texto": "umas roupas novas,", "de": 54.1, "ate": 54.74, "pos": 0.76}, {"f": 2, "texto": "mano.", "de": 54.82, "ate": 54.92, "pos": 0.76}, {"f": 2, "texto": "Qual que é essa daqui?", "de": 55.83, "ate": 56.49, "pos": 0.76}, {"f": 2, "texto": "Eu gostei.", "de": 60.0, "ate": 60.7, "pos": 0.76}]}