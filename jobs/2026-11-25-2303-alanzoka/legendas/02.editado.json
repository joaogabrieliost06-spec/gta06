{"blocos": [{"f": 1, "texto": "Caralho, não passa,", "pos": 0.6}, {"f": 1, "texto": "velho, não passa,", "pos": 0.6}, {"f": 1, "texto": "não passa, eu tentei de novo,", "pos": 0.6}, {"f": 1, "texto": "não passa mesmo", "pos": 0.6}, {"f": 1, "texto": "Caralho, tava perfeito agora,", "pos": 0.6}, {"f": 1, "texto": "velho, tava perfeito, não passa,", "pos": 0.6}, {"f": 1, "texto": "o avião é maior que a ponte", "pos": 0.6}, {"f": 1, "texto": "Eu queria passar, cara,", "pos": 0.6}, {"f": 1, "texto": "eu tenho que passar embaixo", "pos": 0.6}, {"f": 1, "texto": "de 202 pontos nesse jogo,", "pos": 0.6}, {"f": 1, "texto": "204, quer dizer,", "pos": 0.6}, {"f": 1, "texto": "eu tenho que passar embaixo", "pos": 0.6}, {"f": 1, "texto": "de 204 pontos, mano", "pos": 0.6}, {"f": 1, "texto": "O cara me arrependi, velho,", "pos": 0.6}, {"f": 1, "texto": "de tentar passar na ponte,", "pos": 0.6}, {"f": 1, "texto": "não vou mentir, vou treinar,", "pos": 0.6}, {"f": 1, "texto": "vou fazer tudo de novo", "pos": 0.6}, {"f": 1, "texto": "Ah, nessa não passa,", "pos": 0.6}, {"f": 1, "texto": "porque um avião com as asas menores", "pos": 0.6}, {"f": 1, "texto": "existe, esse daqui que a envergadura", "pos": 0.6}, {"f": 1, "texto": "dele é muito alta, velho", "pos": 0.6}, {"f": 1, "texto": "Não, não vou repetir, não.", "pos": 0.6}, {"f": 1, "texto": "Duas vezes é o máximo que eu repito.", "pos": 0.6}, {"f": 1, "texto": "Igual quando eu tava na quinta série.", "pos": 0.6}, {"f": 1, "texto": "Não passa, que...", "pos": 0.6}, {"f": 1, "texto": "Mano, a primeira eu tava torto,", "pos": 0.6}, {"f": 1, "texto": "a segunda eu fui confirmar,", "pos": 0.6}, {"f": 1, "texto": "a terceira não tem,", "pos": 0.6}, {"f": 1, "texto": "porque eu não passo.", "pos": 0.6}, {"f": 1, "texto": "Não passa, chat.", "pos": 0.6}]}